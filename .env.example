# Falcon Food Art — server-only secrets. Never expose service-role/OpenAI keys to NEXT_PUBLIC_*.
FALCON_ART_SUPABASE_URL=
FALCON_ART_SUPABASE_SERVICE_ROLE_KEY=
FALCON_ART_BUCKET=falcon-food-art
FALCON_ART_REVIEW_BUCKET=falcon-food-art-review
OPENAI_API_KEY=
FALCON_ART_CRON_SECRET=

# Zero-cost production default. Local reusable illustrations power the app.
# Change to 1 only when Falcon Fuel has explicit budget for paid image generation.
FALCON_ART_ENABLE_PAID_GENERATION=0

# Locked premium-generation defaults. These remain dormant while the switch above is 0.
FALCON_ART_IMAGE_MODEL=gpt-image-2-2026-04-21
FALCON_ART_IMAGE_SIZE=2880x2880
FALCON_ART_QA_MODEL=gpt-5.6-sol
FALCON_ART_MAX_CANDIDATES=3

# Queue resilience. A terminated worker lock is reclaimed only after this window.
FALCON_ART_STALE_JOB_MINUTES=45
FALCON_ART_MAX_JOB_ATTEMPTS=3

# Optional one-time backfill controls.
FALCON_ART_BACKFILL_DAYS_BACK=30
FALCON_ART_BACKFILL_DAYS_FORWARD=14
FALCON_ART_BACKFILL_GENERATE=0
