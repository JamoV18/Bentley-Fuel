# Falcon Food Art — server-only secrets. Never expose service-role/OpenAI keys to NEXT_PUBLIC_*.
FALCON_ART_SUPABASE_URL=
FALCON_ART_SUPABASE_SERVICE_ROLE_KEY=
FALCON_ART_BUCKET=falcon-food-art
OPENAI_API_KEY=
FALCON_ART_CRON_SECRET=

# Locked production defaults. Change only when deliberately migrating art versions.
FALCON_ART_IMAGE_MODEL=gpt-image-2
FALCON_ART_IMAGE_SIZE=2880x2880

# Optional one-time backfill controls.
FALCON_ART_BACKFILL_DAYS_BACK=30
FALCON_ART_BACKFILL_DAYS_FORWARD=14
FALCON_ART_BACKFILL_GENERATE=0
